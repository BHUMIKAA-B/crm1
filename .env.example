# VisitSarva CRM Environment Variables Template
# Copy this file to .env and replace placeholders with real values for local development.

# Database
MONGO_URL=mongodb://localhost:27017/visitsarva
DB_NAME=visitsarva

# Authentication / JWT
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_TTL_MINUTES=1440

# Security / Passwords
CRM_GATE_PASSWORD=your_secure_crm_gateway_password
CRM_DEFAULT_EMPLOYEE_PASSWORD=your_default_employee_password
ADMIN_EMAIL=admin@visitsarva.in
ADMIN_PASSWORD=your_admin_password

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
REACT_APP_BACKEND_URL=http://localhost:8000

# ─── AI Calling Agent (Twilio + Gemini) ────────────────────────────────────────
# Twilio credentials — obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A verified/purchased Twilio phone number in E.164 format (e.g. +912212345678)
TWILIO_CALLER_ID=+91XXXXXXXXXX
# Public HTTPS base URL of this backend — used to build TwiML webhook URLs
# On Render: https://your-service-name.onrender.com
# On Railway: https://your-service-name.up.railway.app
TWILIO_WEBHOOK_BASE=https://your-backend-domain.com
# Set to "true" to enable outbound calls (default: false — safe)
CALLING_ENABLED=false
# Allowed calling window in IST (24-hour, inclusive start, exclusive end)
CALLING_HOUR_START=9
CALLING_HOUR_END=21
# Maximum automatic retry attempts per enquiry
CALLING_MAX_RETRIES=3
# Set to "false" to skip Twilio signature verification in local dev
VERIFY_TWILIO_SIG=true

# Google Gemini API key — used for AI conversation generation
GEMINI_API_KEY=your_gemini_api_key
