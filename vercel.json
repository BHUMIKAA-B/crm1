{
  "version": 2,
  "buildCommand": "cd frontend && npm run build && node -e \"require('fs').cpSync('build', '../build', {recursive: true})\"",
  "outputDirectory": "frontend/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|health|docs|openapi.json|static|favicon.ico|manifest.json).*)" ,
      "destination": "/index.html"
    }
  ]
}
