# MongoDB Connection String
MONGO_URL=mongodb://localhost:27017/visitsarva
# Name of Database (optional, derived from MONGO_URL by default)
DB_NAME=visitsarva

# JWT Secrets for Authentication
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Access Token Time-to-Live
ACCESS_TOKEN_TTL_MINUTES=1440

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CRM Gateway — Layer 1 common password (set a strong value in production)
# NEVER commit the real password to Git
CRM_GATE_PASSWORD=your_secure_crm_gateway_password
